# MCP Codebase Oracle — Environment Variables

# Cache directory (default: platform-specific - AppData/XDG)
# ORACLE_CACHE_DIR=~/.cache/mcp-codebase-oracle

# Maximum file size to parse (bytes, default: 5MB)
# ORACLE_MAX_FILE_SIZE=5242880

# Maximum number of files to index (default: 100000)
# ORACLE_MAX_FILES=100000

# Log level (DEBUG, INFO, WARNING, ERROR)
# ORACLE_LOG_LEVEL=INFO

# Exclude patterns (comma-separated, added to .gitignore patterns)
# ORACLE_EXCLUDE_PATTERNS=node_modules,dist,build,.git

# Enable git integration (default: true)
# ORACLE_GIT_ENABLED=true
